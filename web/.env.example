# Copiar a .env.local y completar. Ver docs/configuracion/variables-entorno.md
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=alertabga-evidencias
# Solo local (Supabase Storage S3 como sustituto de R2); vacíos en producción:
R2_ENDPOINT_URL=
R2_PUBLIC_ENDPOINT_URL=
R2_REGION=auto
# Obligatorio en producción (valor aleatorio largo): sal para claves anónimas de rate limit
RATE_LIMIT_SALT=
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=alertabga
API_ALLOWED_ORIGINS=http://localhost:3000
# Sesiones de la app ciudadana (ADR 0003): valor aleatorio de 32+ caracteres
CITIZEN_JWT_SECRET=
# Correo para el código de recuperación (sin SMTP_HOST se escribe en el log, solo local)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
