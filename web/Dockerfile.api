# API FastAPI de AlertaBGA para desarrollo local con Docker (en producción corre como función de Vercel).
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY requirements.txt ./
RUN pip install -r requirements.txt "uvicorn[standard]>=0.32" tzdata

COPY api ./api

# Usuario sin privilegios
RUN useradd --create-home --uid 10001 alertabga
USER alertabga

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/py/health', timeout=2).status == 200 else 1)"

CMD ["uvicorn", "api.index:app", "--host", "0.0.0.0", "--port", "8000"]
